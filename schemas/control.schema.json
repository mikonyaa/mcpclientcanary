{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "runId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "scenario": {
      "type": "string",
      "enum": [
        "same-name",
        "fresh-b",
        "no-change",
        "added-tool",
        "description-only",
        "schema-only"
      ]
    },
    "phase": {
      "type": "string",
      "enum": [
        "A",
        "B"
      ]
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2
    },
    "barrierToken": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    }
  },
  "required": [
    "schemaVersion",
    "runId",
    "scenario",
    "phase",
    "generation"
  ],
  "additionalProperties": false
}

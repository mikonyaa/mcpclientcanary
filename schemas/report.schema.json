{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "runId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "timestamp": {
      "type": "string"
    },
    "toolVersion": {
      "type": "string"
    },
    "sourceCommit": {
      "type": "string"
    },
    "environment": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "clients": {
      "type": "array",
      "items": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {}
      }
    },
    "negotiatedProtocol": {
      "type": "string",
      "const": "2025-11-25"
    },
    "adapterVersion": {
      "type": "string"
    },
    "captureMode": {
      "type": "string",
      "const": "loopback-synthetic-pre-inference"
    },
    "recorded": {
      "type": "boolean"
    },
    "exitCode": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "client": {
            "type": "string"
          },
          "nativeVersion": {
            "type": "string"
          },
          "repeat": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "scenario": {
            "type": "string",
            "enum": [
              "same-name",
              "fresh-b",
              "no-change",
              "added-tool",
              "description-only",
              "schema-only"
            ]
          },
          "fixtureHash": {
            "type": "string"
          },
          "harnessStatus": {
            "type": "string",
            "enum": [
              "complete",
              "error",
              "incomplete",
              "cancelled"
            ]
          },
          "clientContractStatus": {
            "type": "string",
            "enum": [
              "observed-pass",
              "observed-fail",
              "unknown"
            ]
          },
          "exitCode": {
            "anyOf": [
              {
                "type": "number",
                "const": 0
              },
              {
                "type": "number",
                "const": 1
              },
              {
                "type": "number",
                "const": 2
              },
              {
                "type": "number",
                "const": 3
              },
              {
                "type": "number",
                "const": 130
              }
            ]
          },
          "stages": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "observed-pass",
                    "observed-fail",
                    "not-supported",
                    "not-reached"
                  ]
                },
                "reason": {
                  "type": "string"
                },
                "evidenceRefs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "id",
                "status",
                "reason",
                "evidenceRefs"
              ],
              "additionalProperties": false
            }
          },
          "definitions": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "resolved",
                    "unknown",
                    "ambiguous"
                  ]
                },
                "reason": {
                  "type": "string"
                },
                "descriptionStatus": {
                  "type": "string",
                  "enum": [
                    "current",
                    "stale",
                    "unknown"
                  ]
                },
                "schemaStatus": {
                  "type": "string",
                  "enum": [
                    "current",
                    "stale",
                    "unknown"
                  ]
                },
                "current": {
                  "anyOf": [
                    {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {}
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "historical": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {}
                  }
                },
                "loaded": {
                  "anyOf": [
                    {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {}
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "evidenceRefs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "status",
                "reason",
                "descriptionStatus",
                "schemaStatus",
                "current",
                "historical",
                "loaded",
                "evidenceRefs"
              ],
              "additionalProperties": false
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "ref": {
                  "type": "string"
                },
                "producer": {
                  "type": "string",
                  "enum": [
                    "server",
                    "model",
                    "native",
                    "harness"
                  ]
                },
                "instance": {
                  "type": "string"
                },
                "pid": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "seq": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "elapsedMs": {
                  "type": "number",
                  "minimum": 0
                },
                "phase": {
                  "type": "string"
                },
                "generation": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "direction": {
                  "type": "string",
                  "enum": [
                    "in",
                    "out",
                    "local"
                  ]
                },
                "event": {
                  "type": "string"
                },
                "data": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                },
                "digest": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "ref",
                "producer",
                "instance",
                "pid",
                "seq",
                "elapsedMs",
                "phase",
                "generation",
                "direction",
                "event",
                "data",
                "digest"
              ],
              "additionalProperties": false
            }
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "omissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "continuity": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "window": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "provenance": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "id",
          "client",
          "nativeVersion",
          "repeat",
          "scenario",
          "fixtureHash",
          "harnessStatus",
          "clientContractStatus",
          "exitCode",
          "stages",
          "definitions",
          "evidence",
          "errors",
          "omissions",
          "continuity",
          "window",
          "provenance"
        ],
        "additionalProperties": false
      }
    },
    "omissions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reproduceCommands": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schemaVersion",
    "runId",
    "timestamp",
    "toolVersion",
    "sourceCommit",
    "environment",
    "clients",
    "negotiatedProtocol",
    "adapterVersion",
    "captureMode",
    "recorded",
    "exitCode",
    "cases",
    "omissions",
    "reproduceCommands"
  ],
  "additionalProperties": false
}
